            <script type="module">
              const error = {"message":"The file does not exist at \"/Users/saifullahjafri/ogcops/node_modules/.vite/deps_ssr/@astrojs_cloudflare_entrypoints_server.js?v=e6dee330\" which is in the optimize deps directory. The dependency might be incompatible with the dep optimizer. Try adding it to `optimizeDeps.exclude`.","stack":"    at runInRunnerObject (workers/runner-worker/index.js:107:3)\n    at getWorkerEntryExport (workers/runner-worker/index.js:241:17)\n    at null.\u003canonymous> (workers/runner-worker/index.js:360:24)\n    at maybeCaptureError (workers/runner-worker/index.js:51:10)","frame":""}
              try {
                const { ErrorOverlay } = await import("/@vite/client")
